# ─── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Used to build absolute image URLs. Leave empty to return relative /uploads/... paths.
PUBLIC_BASE_URL=
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=90d

# ─── Database ──────────────────────────────────────────────
# Leave empty to use the built-in JSON file store (data/db.json) — zero setup.
MONGODB_URI=
# mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=hisaab

# ─── AI (Gemini) ───────────────────────────────────────────
# Leave empty to run in MOCK AI mode (realistic fake results, zero cost).
GEMINI_API_KEY=
# gemini-3.5-flash-lite: ~2 s per photo, steady, cheapest ($0.30/$2.50 per 1M tokens). Main model.
# gemini-3.6-flash: bigger, ~3 s, but often "high demand" (503) in Oct 2026. Used as backup.
# gemini-3.8-flash was timing out; gemini-2.5-* is legacy and new keys can't use it.
GEMINI_MODEL=gemini-3.5-flash-lite
# Backups, comma-separated, tried in order if the main model times out, is overloaded or out of quota
# (empty = off). Free-tier keys get only ~20 requests/day per flash model: turn on billing for real use.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite,gemini-3.6-flash
# Optional second Gemini account (another Google account's key): its own free quota for photos
GEMINI_API_KEY_2=
# Optional: Groq answers text-only requests first (coach, typed meals, reminders, item edits).
# Photos always use Gemini. Free tier: ~1,000 requests/day and 8,000 tokens/min PER MODEL.
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# USD per 1M tokens — used only for unit-economics reporting. Update if you change model.
GEMINI_PRICE_INPUT_PER_M=0.30
GEMINI_PRICE_OUTPUT_PER_M=2.50

# ─── Freemium limits (per day) ─────────────────────────────
FREE_SCANS_PER_DAY=3
FREE_CHATS_PER_DAY=5
PRO_SCANS_PER_DAY=60
PRO_CHATS_PER_DAY=150

# ─── Notifications ─────────────────────────────────────────
# Server-side "smart nudges" (push if lunch/dinner not logged). Needs Expo push tokens.
NUDGES_ENABLED=true

# ─── Limits ────────────────────────────────────────────────
# Free-plan quotas (scans/chats per day) and the 3-recalculations-per-meal cap.
# Off for the MVP; set true before launch.
LIMITS_ENABLED=false

# ─── Admin ─────────────────────────────────────────────────
# Header x-admin-key for /api/admin/* (unit economics). Empty = admin routes disabled.
ADMIN_KEY=
# Allow POST /api/subscription/mock-upgrade (flip isPro without payment). Disable in prod.
ALLOW_MOCK_UPGRADE=true
